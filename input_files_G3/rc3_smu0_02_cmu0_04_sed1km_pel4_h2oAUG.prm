  set List of postprocessors = visualization,velocity statistics, basic statistics, temperature statistics,heat flux statistics, depth average, particles

  subsection Particles
                set List of particle properties = pT path, initial composition, composition
                set Number of particles = 10000
                set Time between data output = 0.1
                set Data output format = vtu
                set Particle generator name = uniform box
                subsection Generator
                       subsection Uniform box
                                set Maximum x = 3550000
                                set Minimum x = 2050000
                                set Maximum y = 1449900
                                set Minimum y = 1441900
                       end
               end
  end

  subsection Visualization
